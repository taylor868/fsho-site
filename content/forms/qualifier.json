{
  "id": "qualifier",
  "version": 2,
  "page": "/step-2/",
  "start": "type",
  "_how": "EMOTA qualifier. Contact + address come first from the hero form (partial lead saved). One question per screen. next = question id, @score (grade EMOTA) or @end:<ending>. pass = true/false for the question's own letter, or {\"M\":false,...} for several letters. A letter passes only if every answer in it passed. Categories are internal; sellers never see them.",
  "categories": {
    "property": "Property gate (hard declines, not scored)",
    "E": "Equity",
    "M": "Motivation",
    "O": "Ownership",
    "T": "Timeframe",
    "A": "Ability"
  },
  "result": {
    "all_pass": {
      "tier": "hot",
      "ending": "hot",
      "cadence": "speed-to-lead"
    },
    "any_fail": {
      "tier": "nurture",
      "ending": "nurture",
      "cadence": "60day",
      "fail_tag": "emota-fail-",
      "near_miss_tag": "emota-4of5"
    }
  },
  "questions": [
    {
      "id": "type",
      "category": "property",
      "label": "What kind of property is it?",
      "options": [
        {
          "label": "Single-family house",
          "value": "sfh",
          "next": "listed"
        },
        {
          "label": "Townhouse",
          "value": "townhouse",
          "next": "@end:not_fit",
          "tag": "no-townhouse"
        },
        {
          "label": "Multi-family (2-4 units)",
          "value": "multi_2_4",
          "next": "listed"
        },
        {
          "label": "Condo",
          "value": "condo",
          "tag": "no-condo",
          "next": "@end:not_fit"
        },
        {
          "label": "Mobile or manufactured home",
          "value": "mobile",
          "tag": "no-mobile",
          "next": "@end:not_fit"
        },
        {
          "label": "Vacant land",
          "value": "land",
          "tag": "no-land",
          "next": "@end:not_fit"
        }
      ]
    },
    {
      "id": "listed",
      "category": "M",
      "label": "Is the house listed with an agent right now?",
      "options": [
        {
          "label": "No, it's not listed",
          "value": "not_listed",
          "pass": {
            "M": true,
            "T": true
          },
          "next": "equity"
        },
        {
          "label": "Yes, it's listed",
          "value": "listed",
          "next": "listed_days"
        },
        {
          "label": "It was, but the listing expired",
          "value": "expired",
          "pass": {
            "M": true,
            "T": true
          },
          "tag": "expired-listing",
          "next": "equity"
        }
      ]
    },
    {
      "id": "listed_days",
      "category": "M",
      "label": "How long has it been listed?",
      "options": [
        {
          "label": "Less than 90 days",
          "value": "under_90",
          "pass": {
            "M": false
          },
          "tag": "listed-under-90",
          "next": "equity"
        },
        {
          "label": "90 days or more",
          "value": "over_90",
          "pass": {
            "M": true,
            "T": true
          },
          "tag": "listed-over-90",
          "next": "equity"
        }
      ]
    },
    {
      "id": "equity",
      "category": "E",
      "label": "Roughly how much is still owed on the house?",
      "options": [
        {
          "label": "Nothing, it's paid off",
          "value": "free_clear",
          "pass": true,
          "next": "situation"
        },
        {
          "label": "Less than half of what it's worth",
          "value": "under_half",
          "pass": true,
          "next": "situation"
        },
        {
          "label": "More than half of what it's worth",
          "value": "over_half",
          "pass": true,
          "next": "situation"
        },
        {
          "label": "About what it's worth, or more",
          "value": "underwater",
          "pass": false,
          "next": "situation"
        }
      ]
    },
    {
      "id": "situation",
      "category": "M",
      "label": "What's the main reason you're thinking of selling?",
      "options": [
        {
          "label": "Inherited / probate",
          "value": "probate",
          "pass": true,
          "next": "title"
        },
        {
          "label": "Behind on payments",
          "value": "behind",
          "pass": true,
          "next": "title"
        },
        {
          "label": "Code violations or fines",
          "value": "code",
          "pass": true,
          "next": "title"
        },
        {
          "label": "Fire, water, or storm damage",
          "value": "damage",
          "pass": true,
          "next": "title"
        },
        {
          "label": "Tired of tenants",
          "value": "tenants",
          "pass": true,
          "next": "title"
        },
        {
          "label": "Needs too many repairs",
          "value": "needs_work",
          "pass": true,
          "next": "title"
        },
        {
          "label": "Divorce, job move, or other life change",
          "value": "life_change",
          "pass": true,
          "next": "title"
        },
        {
          "label": "Something else / just curious",
          "value": "curious",
          "pass": false,
          "next": "title"
        }
      ]
    },
    {
      "id": "title",
      "category": "O",
      "label": "Are you on the title, or the legal decision-maker?",
      "options": [
        {
          "label": "Yes, I'm on the title",
          "value": "owner",
          "pass": true,
          "next": "owners_agree"
        },
        {
          "label": "I'm the executor, POA, or heir",
          "value": "decision_maker",
          "pass": true,
          "next": "owners_agree"
        },
        {
          "label": "No",
          "value": "no",
          "pass": false,
          "tag": "not-decision-maker",
          "next": "owners_agree"
        }
      ]
    },
    {
      "id": "owners_agree",
      "category": "O",
      "label": "Is everyone on the title on board with selling?",
      "options": [
        {
          "label": "Yes, or I'm the only owner",
          "value": "yes",
          "pass": true,
          "next": "timeline"
        },
        {
          "label": "No",
          "value": "no",
          "pass": false,
          "next": "timeline"
        },
        {
          "label": "Not sure yet",
          "value": "unsure",
          "pass": false,
          "next": "timeline"
        }
      ]
    },
    {
      "id": "timeline",
      "category": "T",
      "label": "When do you need to sell?",
      "options": [
        {
          "label": "As soon as possible",
          "value": "asap",
          "pass": true,
          "next": "issues"
        },
        {
          "label": "Within 30 days",
          "value": "30d",
          "pass": true,
          "next": "issues"
        },
        {
          "label": "In 30-90 days",
          "value": "30_90d",
          "pass": true,
          "next": "issues"
        },
        {
          "label": "More than 90 days out",
          "value": "over_90d",
          "pass": false,
          "next": "issues"
        },
        {
          "label": "No rush, just looking",
          "value": "no_rush",
          "pass": false,
          "tag": "long-term",
          "next": "issues"
        }
      ]
    },
    {
      "id": "issues",
      "category": "A",
      "label": "Anything that could hold up a sale?",
      "options": [
        {
          "label": "Nothing that I know of",
          "value": "none",
          "pass": true,
          "next": "move_out"
        },
        {
          "label": "Liens or back taxes the sale should cover",
          "value": "liens_covered",
          "pass": true,
          "tag": "liens",
          "next": "move_out"
        },
        {
          "label": "Liens or back taxes bigger than the house is worth",
          "value": "liens_over",
          "pass": false,
          "tag": "liens-over-value",
          "next": "move_out"
        },
        {
          "label": "Probate is already open",
          "value": "probate_open",
          "pass": true,
          "tag": "probate-open",
          "next": "move_out"
        },
        {
          "label": "Probate hasn't been started",
          "value": "probate_not_started",
          "pass": false,
          "tag": "probate-not-started",
          "next": "move_out"
        },
        {
          "label": "Not sure",
          "value": "unsure",
          "pass": true,
          "tag": "check-title",
          "next": "move_out"
        }
      ]
    },
    {
      "id": "move_out",
      "category": "A",
      "label": "Could you be moved out by closing day?",
      "options": [
        {
          "label": "Yes, or it's already empty",
          "value": "yes",
          "pass": true,
          "next": "@score"
        },
        {
          "label": "Yes, with a little extra time",
          "value": "need_time",
          "pass": true,
          "tag": "needs-extra-time",
          "next": "@score"
        },
        {
          "label": "No",
          "value": "no",
          "pass": false,
          "next": "@score"
        }
      ]
    }
  ],
  "endings": {
    "hot": {
      "headline": "You're a great fit. Expect a call in the next few minutes.",
      "body": "Keep your phone close. Want to go faster? Call us now.",
      "conversion": "qualified_lead"
    },
    "nurture": {
      "headline": "Thanks! We've got your info.",
      "body": "We'll check in with options that fit your timeline. No pressure.",
      "conversion": "none"
    },
    "not_fit": {
      "headline": "Thanks for the details.",
      "body": "This one may not be a fit for us right now, but we saved your info and will reach out if anything changes.",
      "tier": "disqualified",
      "cadence": "none",
      "conversion": "none"
    }
  },
  "consent": {
    "enabled": false,
    "required": false,
    "field": "sms_consent",
    "text": "PLACEHOLDER: texting consent wording to be approved for compliance.",
    "_note": "Off until the compliant wording is decided. When enabled, a non-prechecked checkbox shows on the contact screen and its value + text go in the payload."
  }
}
